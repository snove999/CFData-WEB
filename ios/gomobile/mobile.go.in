package cfdatacore

import (
	"flag"
	"fmt"
	"net"
	"net/http"
	"os"
	"strconv"
	"sync"
	"sync/atomic"
	"time"
)

var (
	stateMu sync.Mutex
	running bool
	exitErr string
	// backendStartSeq 为后端实际启动次数（单调递增），仅用于第一阶段性能日志中的启动代次。
	backendStartSeq int64
)

// Start 在 iOS App 进程内启动 Web 服务。
// dataDir 必须是 App 沙盒内可写目录。若后端仍在运行则直接返回；
// 若上一次已退出（例如 App 挂起后监听 socket 被系统回收），会重新启动。
func Start(dataDir string, port int) error {
	stateMu.Lock()
	defer stateMu.Unlock()
	if running {
		// 第一阶段仅加日志：已在运行直接返回的行为不变。
		perfLogLine("backend_start_skipped", "already_running")
		return nil
	}
	// 第二阶段修正：每次实际启动（非已运行直接返回）都在这里初始化为 starting，
	// 清除上一次的失败状态；Main() 入口也会再置一次 starting（桌面端直接运行的路径）。
	// Main() 是 main.go 中 func main() 经 iOS 构建转换后的名字（见 ios.yml 的 sed）。
	setBackendHealthStatus("starting", "")
	if err := os.MkdirAll(dataDir, 0o700); err != nil {
		setBackendHealthStatus("failed", err.Error())
		return fmt.Errorf("创建数据目录失败: %w", err)
	}
	// 数据文件使用相对路径；配置文件通过 CFDATA_DATA_DIR 定位
	if err := os.Chdir(dataDir); err != nil {
		setBackendHealthStatus("failed", err.Error())
		return fmt.Errorf("切换数据目录失败: %w", err)
	}
	_ = os.Setenv("CFDATA_DATA_DIR", dataDir)
	_ = os.Setenv("CFDATA_IOS", "1")
	_ = os.Setenv("NO_COLOR", "1")
	os.Args = []string{"cfdata", "-host", "127.0.0.1", "-port", strconv.Itoa(port)}
	// Main 会在全局 FlagSet / DefaultServeMux 上注册，重启前需重置以免重复注册 panic
	flag.CommandLine = flag.NewFlagSet(os.Args[0], flag.ContinueOnError)
	http.DefaultServeMux = http.NewServeMux()
	running = true
	exitErr = ""
	// 第一阶段仅加日志：perfLogLine 定义在同包的 session.go 中。
	gen := atomic.AddInt64(&backendStartSeq, 1)
	perfLogLine("backend_start", fmt.Sprintf("backend_gen=%d port=%d data_dir=%s", gen, port, dataDir))
	go func() {
		msg := "后端服务已退出"
		defer func() {
			if r := recover(); r != nil {
				msg = fmt.Sprintf("后端服务崩溃: %v", r)
			}
			stateMu.Lock()
			running = false
			exitErr = msg
			stateMu.Unlock()
			// 第二阶段修正：Main() 已退出时，若健康状态仍为 starting 或 ready，置为 failed；
			// 若状态已为 failed（Main() 已写了更具体的失败原因），noteBackendExited 不会覆盖它。
			noteBackendExited(msg)
			perfLogLine("backend_exit", fmt.Sprintf("backend_gen=%d err=%s", gen, msg))
			// R3 §16.3 testMainExitedHook：Main() 已完全退出后调用（生产恒 nil），
			// 作为“Main() 已完全退出”的确定性信号（见 §8.1/T38 M1）。
			if h := testHookGet(&testMainExitedHook); h != nil {
				h()
			}
		}()
		Main()
	}()
	return nil
}

// IsReady 检测后端端口是否已可连接
func IsReady(port int) bool {
	conn, err := net.DialTimeout("tcp", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)), 300*time.Millisecond)
	if err != nil {
		return false
	}
	_ = conn.Close()
	return true
}

// IsRunning 返回后端 goroutine 是否仍在运行
func IsRunning() bool {
	stateMu.Lock()
	defer stateMu.Unlock()
	return running
}

// LastError 返回后端最近一次退出的原因；为空表示未退出过
func LastError() string {
	stateMu.Lock()
	defer stateMu.Unlock()
	return exitErr
}
